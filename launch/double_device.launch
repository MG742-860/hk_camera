
<launch>
    <!-- 双机（左右各一台）启动。要点（2026-09 复核）：
         1) 本文件未加载 config/hk_camera_config.yaml，所以影像类参数(gain/exposure/gamma...)当前只在
            <node> 的 <param> 里定义，会走"legacy"路径被节点读到；后续统一迁到 yaml（每台一份）。
         2) camera_sn 仍写死在 <param> 里（单机/双机各自能配对成功，暂不改动）；SN 与实机对应关系：
            DA5510091 = 左 / DA5116172 = 右（与单机 launch 的默认值一致）。
         3) enable_resolution=true 才会广播缩放话题，且必须给出正的 resolution_ratio_width/height
            （代码里叫 ratio，实际是缩放后的目标尺寸，cv::resize 直接用这两个值）。关掉或不给正数时
            节点不会广告 /image_rect，下面的 remap 也就没意义。
         4) 两台相机同时 1440x1080/RG8 时理论带宽约 514MB/s，超 USB3 单控制器实用带宽，
            双机同开 165fps 大概率掉帧；双机联调时按需各自降 frame_rate（单机 165.4 是实测上限）。 -->
    <node pkg="nodelet" type="nodelet" name="vision_nodelet_right" args="manager"
          output="screen"/>
    <node pkg="nodelet" type="nodelet" name="hk_camera_right"
          args="load hk_camera/HKCameraNodelet vision_nodelet_right"
          output="screen">
        <param name="camera_name" value="hk_right"/>
        <param name="image_width" value="1440"/>
        <param name="image_height" value="1080"/>
        <param name="pixel_format" value="RG8"/>
        <param name="camera_info_url" value="file://$(find hk_camera)/config/hk_right.yaml"/>
        <param name="camera_frame_id" value="camera_right_optical_frame"/>
        <param name="camera_sn" value="DA5116172"/>
        <param name="frame_rate" value="165.4"/>
        <param name="gain_value" value="14"/>
        <param name="gain_auto" value="false"/>
        <param name="exposure_value" value="2000"/>
        <param name="gamma_selector" value="2"/>
        <param name="gamma_value" value="0.7"/>
        <param name="enable_resolution" value="true"/>
        <param name="resolution_ratio_width" value="1440"/>
        <param name="resolution_ratio_height" value="1080"/>
        <param name="stop_grab" value="false"/>
        <remap from="/image_rect" to="/image_rect_right" />
    </node>
    <node pkg="nodelet" type="nodelet" name="vision_nodelet_left" args="manager"
          output="screen"/>
    <node pkg="nodelet" type="nodelet" name="hk_camera_left"
          args="load hk_camera/HKCameraNodelet vision_nodelet_left"
          output="screen">
        <param name="camera_name" value="hk_left"/>
        <param name="image_width" value="1440"/>
        <param name="image_height" value="1080"/>
        <param name="pixel_format" value="RG8"/>
        <param name="camera_info_url" value="file://$(find hk_camera)/config/hk_left.yaml"/>
        <param name="camera_frame_id" value="camera_left_optical_frame"/>
        <param name="camera_sn" value="DA5510091"/>
        <param name="frame_rate" value="165.4"/>
        <param name="gain_value" value="14"/>
        <param name="exposure_value" value="2000"/>
        <param name="gain_auto" value="false"/>
        <param name="gamma_selector" value="2"/>
        <param name="gamma_value" value="0.7"/>
        <param name="sleep_time" value="3"/>
        <param name="enable_resolution" value="true"/>
        <param name="resolution_ratio_width" value="1440"/>
        <param name="resolution_ratio_height" value="1080"/>
        <param name="stop_grab" value="false"/>
        <remap from="/image_rect" to="/image_rect_left" />
    </node>

</launch>
